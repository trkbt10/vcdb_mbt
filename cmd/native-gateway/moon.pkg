import {
  "moonbitlang/core/env",
  "moonbitlang/core/argparse",
  "moonbitlang/async",
  "trkbt10/vcdb/cli",
  "trkbt10/vcdb/core/types",
  "trkbt10/vcdb/core/storage",
  "trkbt10/vcdb/gateway",
}

import {
  "moonbitlang/core/test",
} for "wbtest"

warnings = "-unused_package"

options(
  "is-main": true,
  targets: {
    "dump.mbt": [ "native" ],
    "load.mbt": [ "native" ],
    "main.mbt": [ "native" ],
    "main_stub.mbt": [ "wasm", "wasm-gc", "js" ],
    "native_gateway_wbtest.mbt": [ "native" ],
  },
)
