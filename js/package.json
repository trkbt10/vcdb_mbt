{
  "name": "vcdb",
  "version": "0.3.0",
  "description": "Minimal, dependency-free vector database with pluggable ANN strategies (bruteforce, HNSW, IVF), attribute filtering, and persistence. Powered by MoonBit WASM. Runs in Node.js, browsers, and edge runtimes.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vcdb-server": "./bin/vcdb-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./distributed": {
      "types": "./dist/distributed.d.ts",
      "import": "./dist/distributed.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js"
    },
    "./storage/memory": {
      "types": "./dist/storage/memory.d.ts",
      "import": "./dist/storage/memory.js"
    },
    "./storage/node": {
      "types": "./dist/storage/node.d.ts",
      "import": "./dist/storage/node.js"
    },
    "./storage/cached": {
      "types": "./dist/storage/cached-storage.d.ts",
      "import": "./dist/storage/cached-storage.js"
    },
    "./storage/indexeddb": {
      "types": "./dist/storage/indexeddb.d.ts",
      "import": "./dist/storage/indexeddb.js"
    },
    "./storage/local-storage": {
      "types": "./dist/storage/local-storage.d.ts",
      "import": "./dist/storage/local-storage.js"
    },
    "./storage/opfs": {
      "types": "./dist/storage/opfs.d.ts",
      "import": "./dist/storage/opfs.js"
    },
    "./storage/service-worker": {
      "types": "./dist/storage/service-worker.d.ts",
      "import": "./dist/storage/service-worker.js"
    },
    "./storage/r2": {
      "types": "./dist/storage/r2.d.ts",
      "import": "./dist/storage/r2.js"
    },
    "./storage/do-kv": {
      "types": "./dist/storage/do-kv.d.ts",
      "import": "./dist/storage/do-kv.js"
    },
    "./storage/types": {
      "types": "./dist/storage/types.d.ts",
      "import": "./dist/storage/types.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "import": "./dist/seed.js"
    },
    "./wasm": {
      "import": "./dist/wasm/lib.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build:moon": "cd .. && moon build --target js ffi",
    "copy:moon": "mkdir -p dist/wasm && cp ../_build/js/debug/build/ffi/ffi.js dist/wasm/lib.js && cp ../_build/js/debug/build/ffi/moonbit.d.ts dist/wasm/ && cp src/wasm/lib.d.ts dist/wasm/",
    "build:ts": "tsc",
    "build": "npm run build:moon && npm run build:ts && npm run copy:moon",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "bash e2e-test.sh",
    "test:smoke": "node test/smoke.test.mjs",
    "test:contract": "node test/contract.test.mjs",
    "test:spec": "npx tsx spec/node.runner.ts",
    "test:spec:browser": "npx tsx spec/browser.runner.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.typecheck.json",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.10",
    "@types/node": "^20.11.0",
    "hono": "^4.12.4",
    "playwright": "^1.58.2",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "hono": ">=4",
    "@hono/node-server": ">=1"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    }
  },
  "keywords": [
    "vector-database",
    "vcdb",
    "ann",
    "hnsw",
    "ivf",
    "similarity-search",
    "wasm",
    "moonbit",
    "indexeddb",
    "opfs",
    "storage"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/trkbt10/vcdb_mbt.git",
    "directory": "js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  }
}
