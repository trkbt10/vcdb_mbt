{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@vcdb/api-client": ["../packages/api-client/src/index.ts"],
      "@vcdb/data-source": ["../packages/data-source/src/index.ts"],
      "@vcdb/db-viewer": ["../packages/db-viewer/src/index.ts"],
      "@vcdb/ui-kit": ["../packages/ui-kit/src/index.ts"],
      "@vcdb/ui-kit/theme": ["../packages/ui-kit/src/theme/index.ts"],
      "@vcdb/ui-kit/toast": ["../packages/ui-kit/src/toast/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/App.tsx",
    "src/constants.ts",
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/styles/**/*",
    "src/hooks/index.ts",
    "src/hooks/useKeyboard.ts",
    "src/hooks/useCollectionApi.ts",
    "src/contexts/DatabaseContext.tsx",
    "src/components/layout/**/*",
    "src/features/registry/hooks/useRegistry.tsx",
    "src/features/registry/hooks/useRegistryApi.ts",
    "src/features/registry/types.ts",
    "src/features/registry/components/index.ts",
    "src/features/registry/components/ConnectionItem.tsx",
    "src/features/registry/components/ConnectionItem.module.css",
    "src/features/registry/components/ConnectionManager.tsx",
    "src/features/registry/components/ConnectionManager.module.css",
    "src/features/registry/components/CreateDatabaseModal.tsx",
    "src/features/registry/components/CreateDatabaseModal.module.css",
    "src/features/explorer/ExplorerPage.tsx",
    "src/features/explorer/ExplorerPage.module.css",
    "src/features/explorer/hooks/index.ts",
    "src/features/explorer/hooks/useVectorData.ts",
    "src/features/explorer/components/index.ts",
    "src/features/explorer/components/AddRowModal.tsx",
    "src/features/explorer/components/AddRowModal.module.css",
    "src/features/explorer/components/CSVImportModal.tsx",
    "src/features/explorer/components/CSVImportModal.module.css",
    "src/features/explorer/components/DataTable.tsx",
    "src/features/explorer/components/DataTable.module.css",
    "src/features/explorer/components/FilterDropdown.tsx",
    "src/features/explorer/components/FilterDropdown.module.css",
    "src/features/explorer/components/FilterEditor.tsx",
    "src/features/explorer/components/FilterEditor.module.css",
    "src/features/explorer/components/InspectorPanel.tsx",
    "src/features/explorer/components/InspectorPanel.module.css",
    "src/features/explorer/components/QueryBar.tsx",
    "src/features/explorer/components/QueryBar.module.css",
    "src/features/explorer/components/StatsTab.tsx",
    "src/features/explorer/components/StatsTab.module.css"
  ],
  "exclude": ["node_modules"]
}
