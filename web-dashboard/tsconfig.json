{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@vcdb/api-client": ["../packages/api-client/src/index.ts"],
      "@vcdb/data-source": ["../packages/data-source/src/index.ts"],
      "@vcdb/db-viewer": ["../packages/db-viewer/src/index.ts"],
      "@vcdb/ui-kit": ["../packages/ui-kit/src/index.ts"],
      "@vcdb/ui-kit/theme": ["../packages/ui-kit/src/theme/index.ts"],
      "@vcdb/ui-kit/toast": ["../packages/ui-kit/src/toast/index.ts"],
      "@vcdb/vcdb-features": ["../packages/vcdb-features/src/index.ts"],
      "@vcdb/vcdb-features/*": ["../packages/vcdb-features/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/test/**/*"]
}
