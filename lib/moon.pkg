import {
  "trkbt10/vcdb",
  "trkbt10/vcdb/core/types",
  "trkbt10/vcdb/core/storage",
  "trkbt10/vcdb/core/persistence/codec",
  "trkbt10/vcdb/core/persistence/collection" @col_persist,
  "trkbt10/vcdb/core/filter",
  "trkbt10/vcdb/gateway",
  "moonbitlang/core/hashmap",
  "moonbitlang/async/js_async",
}

options(
  targets: {
    "persistent_exports.mbt": [ "js" ],
    "gateway_exports.mbt": [ "js" ],
  },
  link: {
    "js": {
      "exports": [
        "vcdb_create",
        "vcdb_create_hnsw",
        "vcdb_create_ivf",
        "vcdb_destroy",
        "vcdb_size",
        "vcdb_dim",
        "vcdb_add",
        "vcdb_upsert",
        "vcdb_get",
        "vcdb_search",
        "vcdb_has",
        "vcdb_remove",
        "vcdb_serialize",
        "vcdb_deserialize",
        "gateway_request",
        "gateway_register_storage",
        "gateway_clear_storage_callbacks",
        "gateway_storage_list",
        "gateway_storage_read",
        "gateway_storage_write",
        "gateway_storage_exists",
        "persistent_register_wal_storage",
        "persistent_register_snapshot_storage",
        "persistent_init",
        "persistent_upsert",
        "persistent_remove",
        "persistent_update_attrs",
        "persistent_checkpoint",
        "persistent_compact",
        "persistent_destroy",
        "persistent_search",
        "persistent_get",
        "persistent_has",
        "persistent_scroll",
        "persistent_scroll_filtered",
        "persistent_count_filtered",
        "persistent_db_size",
        "persistent_db_raw_size",
        "persistent_db_dim",
      ],
    },
  },
)
