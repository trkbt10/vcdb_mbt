        "vcdb_create_hnsw",
        "vcdb_create_ivf",
        "vcdb_destroy",
        "vcdb_size",
        "vcdb_dim",
        "vcdb_add",
        "vcdb_upsert",
        "vcdb_get",
        "vcdb_search",
        "vcdb_has",
        "vcdb_remove",
        "vcdb_serialize",
        "vcdb_deserialize",
        "gateway_request",
        "gateway_register_storage",
        "gateway_clear_storage_callbacks",
        "gateway_storage_list",
        "gateway_storage_read",
        "gateway_storage_write",
        "gateway_storage_exists",
        "async_init_db",
        "async_init_db_from_snapshot",
        "async_replay_wal_and_init",
        "async_upsert",
        "async_search",
        "async_serialize_snapshot",
        "async_wal_header",
        "async_merge_wal",
        "async_db_size",
      ],
    },
  },
)
